# Variáveis lidas por examples/final-project/config/environment.ts.
# Este arquivo documenta configuração: não contém credenciais.
# O config NÃO carrega .env automaticamente; exporte as variáveis no shell ou no CI.

# Opcional. Padrão: https://www.saucedemo.com/ (https obrigatório; http apenas em localhost).
SAUCEDEMO_BASE_URL=

# Opcional. Padrão: standard_user (usuário público exibido na tela de login).
SAUCEDEMO_USERNAME=

# Obrigatória para executar testes (não para --list nem para o type-check).
# Copie a senha exibida na tela de login da SauceDemo. Nunca versione o valor.
SAUCEDEMO_PASSWORD=
