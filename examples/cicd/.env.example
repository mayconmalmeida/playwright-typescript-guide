# Variáveis lidas por examples/cicd/playwright.config.ts.
# Este arquivo documenta configuração: não contém credenciais e não precisa delas.
# O config não carrega .env automaticamente; exporte as variáveis no shell ou no CI.

# local | preview | production. Ausente = local (sobe a aplicação de demonstração).
PLAYWRIGHT_TARGET_ENV=local

# Obrigatória para preview e production (https). Em local, aceita apenas localhost/127.0.0.1.
# Não existe URL padrão para ambientes remotos.
PLAYWRIGHT_BASE_URL=

# Endpoint consultado antes dos testes e prazo para o ambiente ficar pronto.
PLAYWRIGHT_HEALTH_PATH=/api/health
PLAYWRIGHT_READY_TIMEOUT_MS=60000

# Opcional: versão que o ambiente deveria servir (ex.: SHA do commit implantado).
PLAYWRIGHT_EXPECTED_VERSION=

# Somente para a aplicação de demonstração.
# APP_VERSION=dev
# DEMO_FAILURE=courses-500   # simula regressão: /cursos responde 500
# DEMO_FAILURE=health-503    # simula ambiente indisponível
