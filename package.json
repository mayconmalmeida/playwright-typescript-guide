{
  "name": "playwright-typescript-guide",
  "version": "1.0.0",
  "description": "Um guia completo para aprendizado e uso do Playwright com TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:final": "playwright test --config=examples/final-project/playwright.config.ts",
    "test:final:list": "playwright test --config=examples/final-project/playwright.config.ts --list",
    "test:final:smoke": "playwright test --config=examples/final-project/playwright.config.ts --grep @smoke",
    "test:final:report": "playwright show-report examples/final-project/playwright-report",
    "typecheck:final": "tsc --project examples/final-project/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayconmalmeida/playwright-typescript-guide.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mayconmalmeida/playwright-typescript-guide/issues"
  },
  "homepage": "https://github.com/mayconmalmeida/playwright-typescript-guide#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2"
  }
}
